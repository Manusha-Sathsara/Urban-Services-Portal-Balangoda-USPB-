APP_ENV=development
PORT=8080

# Isolated database & least-privilege application role (NOBYPASSRLS)
DB_HOST=localhost
DB_PORT=5432
DB_USER=uspb_app
DB_PASSWORD=replace_with_strong_db_password
DB_NAME=uspb_auth_db
DB_SSLMODE=disable

# Generate with: openssl rand -hex 32 (minimum 32 chars required)
JWT_SECRET=replace_with_at_least_32_char_random_secret_key
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Cookie & CORS security
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
CORS_ALLOWED_ORIGINS=http://localhost:3100

# Brute-force protection
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15
